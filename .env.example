# Vanduo Marse — environment variables.
# Copy to .env.local and fill in from Supabase → Project Settings → API
# (project "Vanduo", ref mwngljhcvqkvncwbmgeo). Both are required: the public
# pages and /admin read from Supabase.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Needed for the staff logins in /admin/darbuotojai and for the SMS phone check before
# every public booking (only the two phone-code functions, closed to anon).
# Supabase → Project Settings → API → service_role. Server only, never prefix with NEXT_PUBLIC_.
# Everything else runs on the anon key with RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the phone-verification tokens and hashes SMS codes and IPs. Required for public
# bookings (without it the phone gate says "call us"). 32+ random characters, server only,
# e.g. `openssl rand -base64 48`. Changing it logs every visitor out of their verified phone.
PHONE_VERIFICATION_SECRET=
# TEST ONLY, leave unset in normal production: 1 shows "Praleisti telefono patvirtinimą" on the phone gate
# and lets anyone book without an SMS code (needs migration 20261104100000). Remove it to close the gate again.
# PHONE_VERIFICATION_SKIP=1

# Email (Resend, resend.com → API Keys; the sender's domain must be verified in Resend → Domains).
# Optional, server only. RESEND_API_KEY sends coupon emails (with COUPON_FROM_EMAIL) and the booking
# emails (with NOTIFY_FROM_EMAIL, falls back to COUPON_FROM_EMAIL): request received, confirmed /
# cancelled, payment received, to a signed-in customer's confirmed email. Without it coupons are passed
# on by hand and bookings are texted only. `pnpm dev` logs booking emails instead of sending them;
# EMAIL_IN_DEV=1 sends real ones. Coupon emails always send.
# RESEND_API_KEY=
# COUPON_FROM_EMAIL="Vanduo Marse <kuponai@vanduomarse.lt>"
# NOTIFY_FROM_EMAIL="Vanduo Marse <rezervacijos@vanduomarse.lt>"
# EMAIL_IN_DEV=1
# Staff booking emails go per service (lib/contacts.ts STAFF_INBOX): sauna + quads → renginiai@vanduomarse.lt,
# stays → miegas@vanduomarse.lt. This is the comma-separated inbox for everything else (event tickets,
# registrations, calculator inquiries). Empty = no staff email for those. marketingas@vanduomarse.lt gets
# a copy of every new-request and paid email regardless (STAFF_BOOKING_COPY in lib/contacts.ts).
# STAFF_NOTIFY_EMAIL=info@vanduomarse.lt

# Booking SMS (Twilio). The first three are required in production: the phone gate texts
# the verification code with them, so without them nobody can book online (in `pnpm dev`
# the code is printed to the server log and the form confirms it by itself: no SMS step, number only,
# and no SMS is ever sent from `pnpm dev`, even with these set; add SMS_IN_DEV=1 to send real ones). Server only. TWILIO_FROM_NUMBER is E.164, e.g. +48732143482.
# STAFF_NOTIFY_PHONE gets the staff SMS only until someone is added in /admin/pranesimai (which then replaces it); leave empty for none.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMS_IN_DEV=1
# STAFF_NOTIFY_PHONE=
# Countries that may receive SMS (default +370,+371,+372,+48); guards against SMS pumping.
# SMS_ALLOWED_PREFIXES=+370,+371,+372,+48

# Booking widgets (/embed/*, framed by the WordPress plugin in wordpress/). Comma-separated
# origins allowed to embed them, e.g. https://vanduomarse.lt,https://www.vanduomarse.lt.
# Empty = only this app may frame them. On Vercel, redeploy after changing it.
# EMBED_ALLOWED_ORIGINS=

# Online payment on /rezervacija (Stripe Checkout, ADR-0026). Both are required to switch it on;
# without them the page files requests as before and staff confirm by phone. Server only.
# Use a Stripe sandbox for development. STRIPE_SECRET_KEY: a restricted key (rk_...) that can write
# Checkout Sessions and read Payment Intents, or sk_...; STRIPE_WEBHOOK_SECRET: the whsec_... of the
# endpoint https://<site>/api/stripe/webhook (events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired, charge.refunded). Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Public origin for the Stripe return URLs (defaults to the request's origin) and the /paskyra and
# /admin links in emails (left out without it). Production: https://www.vanduomarse.lt (the apex
# redirects to www; Stripe does not follow redirects, so the webhook must use the www host too).
# Also the base for metadata, robots.txt and sitemap.xml (lib/site.ts, defaults to the www host).
# SITE_URL=

# "Coming soon" gate for the whole public site: owners switch it in /admin/svetaine (stored in
# site_settings.coming_soon; on = every public page shows /netrukus with a 503, /admin and /api stay open).
# SITE_GATE=1 is only the fallback used when the database cannot be reached.
# SITE_GATE=1
# Optional preview code: shown as a field on the gate page; the right code lets that browser in
# for 30 days (httpOnly cookie). Use a long code; changing it signs every browser out.
# SITE_GATE_CODE=

# Mobile Admin App (`mobile/` — React Native / Expo).
# Copy into `mobile/.env` (or root `.env.local` if running with Expo env forwarding):
# EXPO_PUBLIC_SUPABASE_URL=         (same as NEXT_PUBLIC_SUPABASE_URL)
# EXPO_PUBLIC_SUPABASE_ANON_KEY=    (same as NEXT_PUBLIC_SUPABASE_ANON_KEY)
# EXPO_PUBLIC_SITE_URL=http://localhost:3000 (or https://www.vanduomarse.lt in production; used for /api/admin/mobile-action)

# Vanduo Marse — environment variables.
# Copy to .env.local and fill in from Supabase → Project Settings → API
# (project "Vanduo", ref mwngljhcvqkvncwbmgeo). Both are required: the public
# pages and /admin read from Supabase.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Needed only to add or remove staff logins in /admin/darbuotojai (owner-only actions).
# Supabase → Project Settings → API → service_role. Server only, never prefix with NEXT_PUBLIC_.
# Everything else runs on the anon key with RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Coupon emails (Resend). Optional: without both, "Pažymėti apmokėtu" still issues
# the code in /admin/kuponai and staff pass it on by hand. Server only.
# RESEND_API_KEY=
# COUPON_FROM_EMAIL="Vanduo Marse <kuponai@vanduomarse.lt>"

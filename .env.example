# Vanduo Marse — environment variables.
# Copy to .env.local and fill in from Supabase → Project Settings → API
# (project "Vanduo", ref mwngljhcvqkvncwbmgeo). Both are required: the public
# pages and /admin read from Supabase.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


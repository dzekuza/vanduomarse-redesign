{
  "name": "vanduomarse-redesign",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm build:wp-plugin && next build",
    "build:wp-plugin": "node --experimental-strip-types scripts/build-wp-plugin.mts",
    "start": "next start",
    "lint": "eslint",
    "mobile": "pnpm --filter vanduomarse-mobile start",
    "mobile:ios": "pnpm --filter vanduomarse-mobile ios",
    "mobile:web": "pnpm --filter vanduomarse-mobile web",
    "mobile:typecheck": "pnpm --filter vanduomarse-mobile typecheck",
    "design:check": "node tools/zero-slop-design/zsd.mjs lint DESIGN.md && node tools/zero-slop-design/zsd.mjs check-code DESIGN.md --config design-check.config.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fflate": "^0.8.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.17.0"
}
